# Application Basics
VITE_BASE_URL=/
VITE_API_BASE_URL=/

# Build Settings
VITE_BUILD_COMPRESS=gzip,brotli
VITE_BUILD_ANALYZE=false

# Network & Performance
VITE_PRECONNECT_ORIGINS=https://m1.apifoxmock.com
VITE_PRELOAD_ASSETS=/favicon.ico

# Sentry (Default Disabled)
VITE_SENTRY_ENABLE=false
VITE_SENTRY_DSN=
VITE_SENTRY_ENV=dev

# OpenAPI
OPENAPI_BASE_URL=http://localhost:3000
