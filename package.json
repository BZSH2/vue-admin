{
  "name": "vue-admin",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "description": "Vue 3 + Vite Admin Template",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:dev",
    "build:dev": "run-p type-check \"build-only --mode dev\"",
    "build:test": "run-p type-check \"build-only --mode test\"",
    "build:uat": "run-p type-check \"build-only --mode uat\"",
    "build:prod": "run-p type-check \"build-only --mode production\"",
    "build-only": "vite build",
    "build:pages": "pnpm build-only",
    "preview": "vite preview",
    "type-check": "vue-tsc --build",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write --experimental-cli src/",
    "lint:oxlint": "oxlint . --fix",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:style": "stylelint --fix \"**/*.{css,less,scss,vue}\"",
    "lint:ci": "pnpm lint && pnpm typecheck",
    "lint:all": "pnpm lint:oxlint && pnpm lint:ci",
    "lint:lint-staged": "lint-staged",
    "test": "vitest",
    "test:e2e": "playwright test",
    "analyze": "cross-env VITE_BUILD_ANALYZE=true pnpm build-only",
    "openApi": "esno openApi/index.ts",
    "openApi:modules": "esno openApi/genModules.ts",
    "openI18n": "esno openI18n/index.ts",
    "changelog": "changelogen --output CHANGELOG.md",
    "changelog:release": "changelogen --release --output CHANGELOG.md",
    "cz": "git pull && git add . && cz",
    "prepare": "husky",
    "clean": "rimraf node_modules",
    "reinstall": "rimraf node_modules && pnpm install"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.13.4",
    "bzsh-tree": "^1.1.0",
    "element-plus": "^2.13.2",
    "js-cookie": "^3.0.5",
    "nprogress": "^0.2.0",
    "pinia": "^3.0.4",
    "pinyin-pro": "^3.28.0",
    "qiankun": "^2.10.16",
    "vue": "^3.5.27",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@intlify/unplugin-vue-i18n": "^11.0.3",
    "@playwright/test": "^1.58.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/js-cookie": "3.0.6",
    "@types/jsdom": "^27.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.9",
    "@types/nprogress": "^0.2.3",
    "@types/nunjucks": "^3.2.6",
    "@types/reserved-words": "^0.1.4",
    "@typescript-eslint/parser": "^8.54.0",
    "@unocss/eslint-config": "^66.6.0",
    "@unocss/vite": "^66.6.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitejs/plugin-vue-jsx": "^5.1.3",
    "@vue/compiler-sfc": "^3.5.27",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "bing-translate-api": "^4.2.0",
    "changelogen": "^0.6.0",
    "commitizen": "^4.3.0",
    "cross-env": "^7.0.3",
    "cz-git": "^1.12.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^2.21.0",
    "eslint-plugin-vue": "~10.7.0",
    "esno": "^4.8.0",
    "glob": "^13.0.1",
    "google-translate-api-x": "^10.7.2",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^27.4.0",
    "jsonc-eslint-parser": "^2.4.2",
    "lint-staged": "^16.2.7",
    "lodash-es": "^4.17.23",
    "npm-run-all2": "^8.0.4",
    "nunjucks": "^3.2.4",
    "openapi3-ts": "^4.5.0",
    "oxlint": "~1.42.0",
    "postcss": "^8.5.6",
    "postcss-html": "^1.8.0",
    "prettier": "3.8.1",
    "reserved-words": "^0.1.2",
    "rimraf": "^6.1.3",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass-embedded": "^1.97.3",
    "stylelint": "^17.1.0",
    "stylelint-config-recess-order": "^7.6.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0",
    "typescript": "~5.9.3",
    "unocss": "^66.6.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.1",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "vitest": "^4.0.18",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.6"
    }
  }
}
